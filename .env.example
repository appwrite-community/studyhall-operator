APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1

# The one credential Studyhall keeps. It reaches the organization, never a project's contents.
APPWRITE_ORGANIZATION_ID=
APPWRITE_PARTNERS_KEY=

# Studyhall's own project: staff accounts and the customer-to-project mapping.
CONTROL_PROJECT_ID=
CONTROL_API_KEY=

# Where every school's classroom lives.
STUDYHALL_DOMAIN=studyhall.app

# The repository every classroom is built from, and the release schools run.
CLASSROOM_REPO_OWNER=appwrite-community
CLASSROOM_REPO_NAME=studyhall-classroom
CLASSROOM_RELEASE=v1.0.0
